# Environment Variables Template
# Copy this file to .env and fill in your actual values

# API Configuration
# VITE_API_URL=https://api.tozyapi.com.tr
# VITE_API_TIMEOUT=5000

# Luna AI Chatbot (if using external API)
# VITE_LUNA_API_KEY=your_api_key_here
# VITE_LUNA_API_URL=https://api.luna-ai.com

# Analytics - Google Analytics 4
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXX

# Contact Form API
VITE_CONTACT_FORM_EMAIL=merhaba@tozyapi.com.tr
# VITE_CONTACT_FORM_WEBHOOK=https://your-webhook-url.com

# Feature Flags
# VITE_ENABLE_CHATBOT=true
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_ADMIN=true

# Build Configuration
VITE_APP_VERSION=1.0.0
VITE_APP_NAME="Toz Yapı Teknolojileri"
VITE_APP_URL="https://www.tozyapi.com.tr"

# Multi-language
VITE_DEFAULT_LANGUAGE=tr
VITE_SUPPORTED_LANGUAGES=tr,en
